<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E">

    <!-- ── Terminal (hidden until environment is ready) ───────────────────── -->
    <LinearLayout
        android:id="@+id/terminal_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top toolbar -->
        <LinearLayout
            android:id="@+id/terminal_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#FF16213E"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Terminal"
                android:textColor="#FF00D4FF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:paddingStart="8dp" />

            <ImageButton
                android:id="@+id/btn_ctrl"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#FFAAAAAA"
                android:contentDescription="Ctrl key" />

            <ImageButton
                android:id="@+id/btn_esc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_delete"
                android:tint="#FFAAAAAA"
                android:contentDescription="Escape key" />

            <ImageButton
                android:id="@+id/btn_tab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#FFAAAAAA"
                android:contentDescription="Tab key" />

            <ImageButton
                android:id="@+id/btn_keyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                android:tint="#FFAAAAAA"
                android:contentDescription="Show keyboard" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFF6B6B"
                android:contentDescription="Close terminal" />

        </LinearLayout>

        <!-- Terminal view -->
        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF0D0D0D" />

        <!-- Arrow key toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#FF16213E"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_arrow_up"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/arrow_up_float"
                android:tint="#FFAAAAAA"
                android:contentDescription="Arrow up" />

            <ImageButton
                android:id="@+id/btn_arrow_down"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/arrow_down_float"
                android:tint="#FFAAAAAA"
                android:contentDescription="Arrow down" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Loading overlay (shown first while environment resolves) ───────── -->
    <LinearLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">_"
            android:textColor="#FF00D4FF"
            android:textSize="48sp"
            android:fontFamily="monospace"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking environment…"
            android:textColor="#FFCCCCCC"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/loading_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>